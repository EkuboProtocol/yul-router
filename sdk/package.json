{
  "name": "@ekubo/yul-router-sdk",
  "version": "0.7.1",
  "description": "Constructs swap transaction calldata and price quotation calldata for the Ekubo Yul Router on EVM chains",
  "keywords": [
    "ekubo",
    "swap",
    "router",
    "quote",
    "calldata",
    "amm",
    "dex",
    "evm",
    "cryptocurrency",
    "blockchain"
  ],
  "homepage": "https://ekubo.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EkuboProtocol/yul-router.git",
    "directory": "sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate-foundry-testdata": "bun scripts/generate-foundry-testdata.mjs",
    "prepublishOnly": "bun run build && bun run test",
    "test": "bun test test/index.test.ts"
  },
  "peerDependencies": {
    "viem": "^2.31.7"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "viem": "^2.31.7"
  }
}
