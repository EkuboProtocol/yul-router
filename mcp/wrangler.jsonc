{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ekubo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "mcp.ekubo.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "EKUBO_API_URL": "https://prod-api.ekubo.org",
    "EKUBO_QUOTER_URL": "https://prod-api-quoter.ekubo.org",
    "ALLOWED_HOSTNAMES": "mcp.ekubo.org,localhost,127.0.0.1",
    "ALLOWED_ORIGINS": "https://mcp.ekubo.org"
  },
  "observability": {
    "enabled": true
  }
}
